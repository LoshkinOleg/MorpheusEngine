          "method": "POST",
          "body_template": "{\"turn\":{{turn}},\"playerInput\":{{playerInputJson}},\"directorResponseBody\":{{step.director_message.rawBodyJson}}}"
        }
      ],
      "response_mapping": {
        "source_step": "director_message",
        "type": "director_message_response"
      }
    }
  },
